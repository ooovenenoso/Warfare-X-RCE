# Public app URL on Railway (origin only)
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never expose this in browser code
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Discord user snowflakes authorized for admin API routes
ADMIN_DISCORD_IDS=
# Optional: same list to show admin navigation in the client; not a secret
NEXT_PUBLIC_ADMIN_DISCORD_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional notification webhook, server-side only
DISCORD_WEBHOOK_URL=
